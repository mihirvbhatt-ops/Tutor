# Optional — you can also paste your key into Settings -> AI Provider after
# starting the app, no .env file needed. Use this file instead if you'd
# rather keep the key in your environment (dev/CI workflows): copy it to
# .env and fill in your own key — .env is gitignored and should never be
# committed. Get a key at https://console.anthropic.com/settings/keys
# (requires billing to be set up on your Anthropic account). A key set here
# always takes precedence over one saved in Settings.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults shown. Only override if you need something different.
# PORT=3001
# TUTOR_DB_PATH=./db/tutor.db
